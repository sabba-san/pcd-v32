# --- Flask Settings ---
FLASK_APP=app:app
FLASK_ENV=development
SECRET_KEY=change-me-in-local-env

# --- Database Connection (For Docker) ---
DATABASE_URL=postgresql://user:password@flask_db:5432/flaskdb

# --- AI API Keys ---
GROQ_API_KEY=replace-with-your-local-groq-api-key
GROQ_API_KEY_REPORT=replace-with-your-report-api-key
GROQ_API_KEY_CHATBOT=replace-with-your-chatbot-api-key

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=masukkan-api-key-google-maps-awak-di-sini

# --- Local Testing for Google SSO (PENTING UNTUK LOCALHOST) ---
OAUTHLIB_INSECURE_TRANSPORT=1